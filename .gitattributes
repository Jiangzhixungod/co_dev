# 统一换行：仓库内一律 LF，按文件类型决定检出时的换行
* text=auto

# shell 脚本与 git 钩子必须是 LF（否则 sh 报 "bad interpreter"）
*.sh text eol=lf
scripts/git-hooks/* text eol=lf

# Windows 批处理与 PowerShell 用 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 工单状态文件由脚本解析，固定 LF
STATUS text eol=lf

# 只追加的日志：多张工单各自追加后合并时，两边都保留，不产生冲突
FIXLOG.md merge=union
